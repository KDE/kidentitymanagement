#, kde-format
msgctxt "continuation of \"obtain signature text from\""
msgid "File"
msgstr "Файл"

#: widgets/signatureconfigurator.cpp:122
#, kde-format
msgctxt "continuation of \"obtain signature text from\""
msgid "Output of Command"
msgstr "Изход на командата"

#: widgets/signatureconfigurator.cpp:123
#, kde-format
